# Copy to .env (gitignored) and fill in locally. Never commit real values.
# Load into your shell with:  set -a; source .env; set +a

# Backend: "ollama" (default, direct local) or "prism" (through the gateway)
RAGBASE_LLM_BACKEND=ollama

# Direct Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Prism gateway (only used when RAGBASE_LLM_BACKEND=prism)
PRISM_BASE_URL=http://localhost:8000
PRISM_MODEL=fast
PRISM_ALLOWED_PROVIDERS=ollama
PRISM_API_KEY=
